# ===========================================
# SayurPintar Environment Configuration
# ===========================================
# Copy this file to .env and adjust values

# ---------- Server ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sayurpintar
POSTGRES_USER=sp_dev
POSTGRES_PASSWORD=sp_dev_password
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNECTIONS=25
POSTGRES_MIN_CONNECTIONS=5

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- MongoDB ----------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=sp_dev
MONGO_PASSWORD=sp_dev_password
MONGO_DB=sayurpintar

# ---------- Meilisearch ----------
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=sp_meili_dev_key

# ---------- JWT ----------
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ---------- WhatsApp (placeholder) ----------
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_verify_token

# ---------- SMS (placeholder) ----------
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_account_sid
SMS_AUTH_TOKEN=your_auth_token
SMS_FROM_NUMBER=+1234567890

# ---------- Maps (placeholder) ----------
MAPS_API_KEY=your_google_maps_api_key
MAPS_PROVIDER=google

# ---------- OTP ----------
OTP_LENGTH=6
OTP_EXPIRY=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s

# ---------- Rate Limiting ----------
RATE_LIMIT_AUTH_PER_MIN=120
RATE_LIMIT_ANON_PER_MIN=30

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- Logging ----------
LOG_LEVEL=debug
LOG_FORMAT=console

# ---------- Environment ----------
APP_ENV=development
